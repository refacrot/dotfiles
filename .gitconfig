[user]
  name = Dmitrii Iakovlev
  email = jakovlev.ds@gmail.com
  signingkey = ssh-rsa 
[gpg]
  format = ssh
[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
[color "status"]
  changed = yellow
[commit]
  gpgsign = true
[core]
  editor = code --wait
  excludesfile = ~/.gitignore_global
[credential "https://github.com"]
  helper =
  helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
  helper =
  helper = !/opt/homebrew/bin/gh auth git-credential
[diff]
  external = difft
[grep]
  lineNumber = true
[pretty]
  lt = format:%C(auto)%h%C(reset) %C(white)-%C(reset) %C(italic blue)%ad%C(reset) %C(italic cyan)(%ar)%C(reset)%C(auto)%d%C(reset)%n %C(white)⤷%C(reset) %s %C(241)- %aN <%aE>%C(reset)%n%w(0,7,7)%+(trailers:only,unfold)
